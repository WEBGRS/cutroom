{
  "name": "cutroom",
  "version": "0.4.1",
  "private": true,
  "description": "A video editor where you and an AI assistant edit the same storyboard file. Built on Remotion.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "node scripts/fetch-fonts.mjs",
    "editor": "node editor/build.mjs && node editor/dist/server.mjs",
    "app": "node editor/build.mjs && node app/launch.mjs",
    "build": "node editor/build.mjs",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit && tsc -p editor/tsconfig.json",
    "test": "node editor/build.mjs && node --test editor/dist/test/ops.test.mjs editor/dist/test/compat.test.mjs editor/dist/test/agents.test.mjs editor/dist/test/voice.test.mjs editor/dist/test/localvoice.test.mjs editor/dist/test/record.test.mjs editor/dist/test/cli.test.mjs editor/dist/test/look.test.mjs editor/dist/test/html.test.mjs editor/dist/test/shots.test.mjs editor/dist/test/jianying.test.mjs editor/dist/test/imagegen.test.mjs editor/dist/test/desktop.test.mjs editor/dist/test/checkpoints.test.mjs editor/dist/test/access.test.mjs",
    "test:e2e": "node editor/test/e2e.mjs showcase",
    "test:oracle": "node editor/test/oracle.mjs showcase",
    "test:app": "node editor/test/app.mjs",
    "test:shots": "node editor/test/uishots.mjs",
    "capture:demo": "node editor/demo/capture.mjs",
    "previews": "node editor/build.mjs && node editor/dist/previews.mjs",
    "dist": "node editor/build.mjs && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@remotion/bundler": "^4.0.532",
    "@remotion/cli": "^4.0.532",
    "@remotion/media": "^4.0.532",
    "@remotion/media-utils": "^4.0.532",
    "@remotion/motion-blur": "^4.0.532",
    "@remotion/noise": "^4.0.532",
    "@remotion/paths": "^4.0.532",
    "@remotion/player": "^4.0.532",
    "@remotion/renderer": "^4.0.532",
    "@remotion/shapes": "^4.0.532",
    "@remotion/transitions": "^4.0.532",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
